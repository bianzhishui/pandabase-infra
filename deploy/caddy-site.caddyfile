# 共享宿主机用的站点配置片段。
#
# 适用场景：这台机器上已有 Caddy（systemd）在服务别的站点，不能把 80/443 让给容器。
# 做法：把下面的块追加到 /etc/caddy/Caddyfile，validate 后 reload。
#
#   sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%F)
#   sudo tee -a /etc/caddy/Caddyfile < deploy/caddy-site.caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy 的全局 email 只能出现在文件最前面。宿主配置里没有的话加：
#   {
#       email admin@pandabase.top
#   }

# ---------------------------------------------------------------------------
# 授权服务器。issuer 一旦对外签发令牌就不可更改（见 docs/decisions/0003）。
# ---------------------------------------------------------------------------
auth.pandabase.top {
	reverse_proxy 127.0.0.1:8001
}

# ---------------------------------------------------------------------------
# 业务站点示例。每接一个业务，复制这一段并改域名与上游端口。
# 上游是业务容器绑在回环上的端口，不是容器内端口。
# ---------------------------------------------------------------------------
baiduads.pandabase.top {
	encode zstd gzip

	# 探活不鉴权：容器 HEALTHCHECK、外部监控、排障都要能直接打到
	handle /healthz {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		# 反代不做鉴权：令牌校验在业务进程内完成。
		# 默认不缓冲，Streamable HTTP 的长连接可以直接穿透。
		reverse_proxy 127.0.0.1:8000
	}
}

# ---------------------------------------------------------------------------
# 运维控制台 DBX（见 docs/decisions/0004）。
#
# 这是本仓库唯一一处「反代做鉴权」。理由不是它可以信任，而是 DBX 没有 OIDC 能力、
# 也**不消费**任何身份头——所以 forward_auth 在这里只当闸门（放行/拒绝），不做身份注入。
# 与此配套的三条约束，改这段之前先读 ADR 0004：
#   1. 不 copy_headers。注入了就是给将来的「header 登录」留一条可伪造的通道。
#   2. DBX 必须只经本反代可达。它只挂 pandabase-ops，业务容器解析不到它。
#   3. DBX 自己仍要有口令。闸门是第二道，不是唯一一道。
# ---------------------------------------------------------------------------
dbx.pandabase.top {
	encode zstd gzip

	# forward-auth 的回调：直接交给 Casdoor，它在这里把会话 cookie 种到 dbx 域上。
	# 少了这段，登录完会落到 DBX 的 404，然后被再踢回登录页。
	handle /caswaf-handler {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		forward_auth 127.0.0.1:8001 {
			uri /api/forward-auth
			# 刻意不写 copy_headers：原因见上。
			# Caddy 会自动带 X-Forwarded-Host/Uri，Casdoor 靠它定位 site。
		}
		reverse_proxy 127.0.0.1:8002
	}
}
