# Casdoor 的连接配置。复制为 deploy/casdoor/.env 后填口令。
# 该文件含数据库口令，已被 .gitignore 排除。
#
# POSTGRES_USER 是 Casdoor 自己的库角色，**不是** platform 的运维角色。
# 它在平台 PG 上只有 casdoor 库的 owner 权限（无 superuser / createdb / createrole）。

POSTGRES_USER=casdoor
# 与旧部署保持一致即可；轮换时先改库里的口令再改这里
POSTGRES_PASSWORD=

# 必须与 DNS 一致，且一旦启用不可更改——它写进每个 JWT 的 iss
CASDOOR_ORIGIN=https://auth.pandabase.top
